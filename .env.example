# Copy to .env and adjust. .env is never committed.

# Where the dashboard listens. 0.0.0.0 = every interface; use the LAN or VPN
# address instead to keep it off the others.
HOST=0.0.0.0
PORT=3010

# How often to read the Pi, in seconds.
INTERVAL_FAST=1
INTERVAL_SLOW=30

# Days of metrics history to keep (one row per minute, ~1 MB per week).
HISTORY_DAYS=30

# Pironman5 case software's local API.
PIRONMAN_API=http://localhost:34001/api/v1.0

# Network interface to measure traffic on (eth0, wlan0, wg0...).
# Empty picks the one your internet goes through.
NET_INTERFACE=

# Host-specific metrics. Leave any of these empty to skip it entirely —
# deploy/install.sh then grants no sudo rule for it either.
WG_INTERFACE=wg0
NVME_DEVICE=/dev/nvme0
F2B_JAIL=sshd
FAN_INPUT=/sys/class/hwmon/hwmon0/fan1_input
CS_ENABLE=false

# Start / stop / restart systemd services and Docker containers from the
# dashboard. There is no login: anyone who can open the page can use this.
UNIT_CONTROL=true
# Comma-separated systemd units that can be restarted but never stopped.
PROTECTED_UNITS=ssh.service,pi-dash.service
